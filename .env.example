# Токен бота от @BotFather (никогда не коммитьте настоящий)
BOT_TOKEN=
# Публичный HTTPS-адрес мини-приложения (Telegram открывает только https)
WEBAPP_URL=https://fpv.example.com/
# Telegram ID администраторов через запятую — им доступна админка
ADMIN_IDS=
# Username бота без @ (для реферальных ссылок; если пусто — берётся из getMe при старте)
BOT_USERNAME=
# Локальная разработка без Telegram: 1 — пускать без подписи initData под DEV_USER_ID
DEV_MODE=0
DEV_USER_ID=1
# Порт веб-сервера внутри контейнера/процесса
PORT=8000
# Путь к SQLite (по умолчанию storage/fpv.db)
# DB_PATH=storage/fpv.db
