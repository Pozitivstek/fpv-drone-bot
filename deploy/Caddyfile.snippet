# FPV-Drons: мини-приложение Telegram. Сам сервис живёт на домашнем сервере,
# сюда он приходит через обратный SSH-туннель (deploy/fpv-tunnel.service) на 127.0.0.1:8096.
fpv.188-130-207-170.sslip.io {
	encode zstd gzip
	request_body {
		max_size 512KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Мини-приложение открывается во фрейме web.telegram.org.
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy 127.0.0.1:8096 {
		health_uri /api/health
		health_interval 60s
	}
}
